# Instagram handle whose followers/following you want to analyze
# (defaults to moments_in_my if unset)
IG_PROFILE=moments_in_my

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# You do NOT need to put your Instagram credentials here.
#
# Recommended flow:
#   1. Run `npm run login`
#   2. Log into instagram.com in the browser window that opens
#      (handle 2FA / checkpoints as a human)
#   3. Your session cookie is stored locally in USER_DATA_DIR and reused
#      on every subsequent run. Your password is never seen by the script.
#
# The two variables below exist only as an escape hatch for headless /
# unattended setups. Leave them EMPTY for personal use — storing your
# Instagram password in a .env file is not worth the risk.
# IG_USERNAME=
# IG_PASSWORD=

# Run the browser visibly (false) or headless (true). Keep false for first run.
HEADLESS=false

# Where Playwright stores the persistent browser profile (cookies, localStorage, etc.).
USER_DATA_DIR=./.browser-data

# Where output files are written.
OUT_DIR=./output

# How aggressively to scroll the follower/following dialog.
# Stop after this many scroll cycles with no new users.
IDLE_SCROLL_LIMIT=8

# Max scroll iterations per list (safety upper bound).
MAX_SCROLL_ITERATIONS=4000

# Base delay between scroll steps (ms). A small random jitter is added.
SCROLL_DELAY_MS=1400
